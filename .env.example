# Copy this file to .env and fill in your Alpaca keys.
#     cp .env.example .env
# .env is ignored by git, so your keys never get uploaded.
# Start with PAPER keys. Paper and live keys are different.

ALPACA_API_KEY=paste-your-paper-key-id-here
ALPACA_SECRET_KEY=paste-your-paper-secret-here

# Paper trading is the default. Live trading needs BOTH:
#   ALPACA_PAPER=false here, AND the --live flag on the command line.
ALPACA_PAPER=true
